# Copy to config/my-machines.env and edit.
#   cp config/my-machines.env.example config/my-machines.env

# Name shown under My Machines on phone / cursor.com/agents
WORKER_NAME=home-mac

# Colon-separated absolute paths to git checkouts this worker can edit.
# Default (if unset): the directory that contains this repo.
# WORKER_DIRS=/Users/you/code/app:/Users/you/code/other

# Set to 1 to allow the agent to drive UI (Accessibility + Screen Recording required)
COMPUTER_USE=0

# Optional: personal user API key instead of browser login (Dashboard → API Keys)
# CURSOR_API_KEY=
